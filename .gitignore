# Blazor build output and the published copy (CI rebuilds these)
level3-blazor/bin/
level3-blazor/obj/
level3-blazor/publish/
level3-app/
blazor-publish/
_site/

# Design mockups - disposable per-phase concept probes (see the mockup-first skill).
# They are thrown away when the phase closes and must never become a second
# source of truth.
_mockup-*.html
_*-probe.html

# Audit-gate reports/logs (pre-push i18n round-trip postmortems)
.audit-gate/
node_modules/

# Journal (decision log): bulky, regenerable ETL firehose + working files.
# Curated docs/journal/{features,decisions,outputs}/ ARE committed (small, non-regenerable).
# activity/ waits for git-lfs (see docs/architecture/decision-log.md).
docs/journal/activity/
docs/journal/_watermark.json
docs/journal/config.json
