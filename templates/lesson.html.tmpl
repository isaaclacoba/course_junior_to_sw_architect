<!--
  templates/lesson.html.tmpl - the source of every generated lesson page.
  tools/generate.mjs emits content/<track>/<NN-part>/<NN-lesson>/index.html for
  each migrated lesson from the matching variant below.

  RELATIVE PREFIX (critical): a generated page lives four directories below the
  repo root -

      content / <track> / <NN-part> / <NN-lesson> / index.html
        (1)      (2)        (3)         (4)

  so every shared asset that lives at the repo root is reached with the fixed
  prefix "../../../../". CDN links (Google Fonts, Prism) are absolute URLs and
  keep no prefix. Every variant below already uses "../../../../".

  HOW A VARIANT IS FOUND: each block is introduced by a marker comment carrying
  its archetype name - "@variant <name>" - and the generator maps the
  doctype..&lt;/html&gt; block that follows to that name. Nothing depends on the
  ORDER of the blocks, so adding an archetype is one marked block here plus one
  row in the generator's ARCHETYPE_RENDER map.

  THE VARIANTS (no engine is loaded statically - the kernel controller injects
  the generic engine + the archetype's plugin at runtime)
    - build      : Monaco write-and-run lessons. No Prism.
    - drill      : fill-in-the-blank / quiz lessons. Prism.
    - viz        : theory pages with a visual scene. <name>.viz.js. Prism.
    - checkpoint : end-of-part quiz. quiz data + page-shell.js only.
                   no Prism JS (the Prism theme CSS is linked but unused, matching
                   the current theory-check-*.html pages).
    - git        : type-real-git-commands lessons (terminal + graph, both from
                   code-lab). Same shape as build - a card scaffold driven by
                   data.js - so no Prism and no Monaco loader.
  Every variant loads the lesson's meta.js and page-shell.js.

  PLACEHOLDER TOKENS (a generator substitutes these)
    {{DOC_TITLE}}   - text for <title>.
    {{EYEBROW}}     - hero eyebrow (e.g. "Part two \u00b7 Everyday essentials").
    {{TITLE}}       - hero title.
    {{INTRO}}       - hero intro; a JS array literal of string | {html,class}.
    {{META_SRC}}    - path to this lesson's meta.js (sets window.LESSON_META).
    {{DATA_SRC}}    - path to the lesson data file (<name>.js) - every archetype
                      except viz.
    {{VIZ_SRC}}     - path to <name>.viz.js - viz only.
    {{PRISM_BLOCK}} - the three Prism <script> tags - drill and viz only.

  Each src token is expected to already include the "../../../../" prefix when it
  points at a repo-root asset (e.g. "../../../../page-shell.js"); meta.js and the
  lesson data file will live next to index.html, so they resolve as bare
  "meta.js" / "<name>.js".
-->


<!-- ============================================================= -->
<!-- @variant build  (Monaco write-and-run) -->
<!-- ============================================================= -->
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{{DOC_TITLE}}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700&family=IBM+Plex+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="../../../../styles.css" />
    <script src="../../../../theme-registry.js"></script>
    <script src="../../../../theme-switch.js"></script>
    <link rel="stylesheet" href="../../../../vendor/code-lab/code-lab.css" />
  </head>
  <body>
    <main class="layout">
      <section class="hero" id="pageHero"></section>
    </main>

    <script>
      window.PAGE = {
        hero: {
          eyebrow: "{{EYEBROW}}",
          title: "{{TITLE}}",
          intro: {{INTRO}},
          links: [{ href: "../../../../index.html", label: "Back to the course" }],
        },
        archetype: "build",
      };
    </script>

    <script src="../../../../vendor/code-lab/code-lab.global.js"></script>
    <script src="../../../../generated/course-data.js"></script>
    <script src="../../../../generated/concept-index.js"></script>
    <script src="{{META_SRC}}"></script>
    <script src="../../../../page-shell.js"></script>
    <script src="{{DATA_SRC}}"></script>
  </body>
</html>


